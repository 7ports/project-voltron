# Voltron socket-proxy: environment-variable form of the allowlist.
#
# This is the EXACT same ruleset as docker-compose.socket-proxy.yml, expressed
# as wollomatic/socket-proxy SP_* environment variables. Use this form if you
# run the proxy with `docker run --env-file` or a non-compose orchestrator.
#
# Multiple rules per method use the _2, _3, _N suffix convention
# (SP_ALLOW_GET, SP_ALLOW_GET_2, ...). Confirmed in the project README.
#
# Paths are auto-anchored with ^ and $ by socket-proxy. Anything not listed is
# denied (secure-by-default).

# ---- logging ----
SP_LOGLEVEL=info
SP_LOGJSON=true

# ---- listener ----
SP_LISTENIP=0.0.0.0
SP_PROXYPORT=2375
SP_SOCKETPATH=/var/run/docker.sock

# ---- who may connect (replace with the voltron-proxy-net CIDR) ----
SP_ALLOWFROM=172.31.0.0/16

# ---- GET: read / inspect ----
SP_ALLOW_GET=(/v1\.[0-9]{1,2})?/_ping
SP_ALLOW_GET_2=(/v1\.[0-9]{1,2})?/version
SP_ALLOW_GET_3=(/v1\.[0-9]{1,2})?/images/.+/json(\?.*)?
SP_ALLOW_GET_4=(/v1\.[0-9]{1,2})?/containers/json(\?.*)?
SP_ALLOW_GET_5=(/v1\.[0-9]{1,2})?/containers/[a-zA-Z0-9][a-zA-Z0-9_.-]*/json(\?.*)?

# ---- POST: create + run lifecycle ----
SP_ALLOW_POST=(/v1\.[0-9]{1,2})?/containers/create(\?.*)?
SP_ALLOW_POST_2=(/v1\.[0-9]{1,2})?/containers/[a-zA-Z0-9][a-zA-Z0-9_.-]*/start(\?.*)?
SP_ALLOW_POST_3=(/v1\.[0-9]{1,2})?/containers/[a-zA-Z0-9][a-zA-Z0-9_.-]*/attach(\?.*)?
SP_ALLOW_POST_4=(/v1\.[0-9]{1,2})?/containers/[a-zA-Z0-9][a-zA-Z0-9_.-]*/wait(\?.*)?

# ---- DELETE: --rm cleanup ----
SP_ALLOW_DELETE=(/v1\.[0-9]{1,2})?/containers/[a-zA-Z0-9][a-zA-Z0-9_.-]*(\?.*)?

# ---- body filter: bind-mount source allowlist (HOST-SIDE path) ----
SP_ALLOWBINDMOUNTFROM=/srv/voltron/workspace

# ---- watchdog ----
SP_WATCHDOGINTERVAL=3600
SP_STOPONWATCHDOG=true
SP_SHUTDOWNGRACETIME=5
