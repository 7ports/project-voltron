{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-voltron.dev/schemas/voltron-evals/task.schema.json",
  "title": "Voltron Eval Task",
  "description": "Schema for benchmark task definitions consumed by voltron-evals/runner.js",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tier",
    "category",
    "agent_under_test",
    "max_turns",
    "project_type",
    "prompt",
    "acceptance_criteria",
    "rubric",
    "rubric_version_expected",
    "programmatic_signals"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T[1-3]-[0-9]{3}$"
    },
    "kind": {
      "type": "string",
      "enum": ["deep", "shape-instance"],
      "default": "deep"
    },
    "tier": {
      "type": "integer",
      "enum": [1, 2, 3]
    },
    "category": {
      "type": "string"
    },
    "agent_under_test": {
      "type": "string"
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "project_type": {
      "type": "string",
      "enum": ["web", "unity", "general"]
    },
    "prompt": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "type"],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["programmatic", "judged"]
          }
        }
      }
    },
    "rubric": {
      "type": "string"
    },
    "rubric_version_expected": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "fixtures": {
      "type": "string"
    },
    "programmatic_signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture_turn_count": {
          "type": "boolean"
        },
        "capture_files_changed": {
          "type": "boolean"
        },
        "detect_micro_agent_dispatch": {
          "type": "boolean"
        },
        "capture_beads_snapshot": {
          "type": "boolean"
        },
        "require_done_line": {
          "type": "boolean"
        },
        "check_doc_updates": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
